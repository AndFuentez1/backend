# === Configuración del Servidor ===
PORT=3001
NODE_ENV=production

# === Gmail OAuth2 ===
# Obtén estas credenciales en: https://console.cloud.google.com/apis/credentials
GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_client_secret
# URL del Backend en Render + /auth/google/callback
GMAIL_REDIRECT_URI=https://trackerfinanciero-utg1.onrender.com/auth/google/callback

# === Supabase ===
# Obtén estas credenciales en tu proyecto de Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# === Encriptación ===
# Clave para encriptar tokens (32 caracteres mínimo)
ENCRYPTION_KEY=your_secret_encryption_key_32_chars
