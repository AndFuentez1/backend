{
    "name": "invoice-processor-backend",
    "version": "1.0.0",
    "description": "Backend para procesamiento automático de facturas desde Gmail",
    "main": "server.js",
    "type": "module",
    "scripts": {
        "start": "tsx server.js",
        "dev": "nodemon -e js,ts,json --exec tsx server.js",
        "build": "echo 'No build step required'",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "keywords": [
        "gmail",
        "invoice",
        "ai",
        "gemini",
        "supabase"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "@supabase/supabase-js": "^2.45.4",
        "adm-zip": "^0.5.16",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.1",
        "express-validator": "^7.2.0",
        "googleapis": "^144.0.0",
        "morgan": "^1.10.0",
        "node-telegram-bot-api": "^0.67.0",
        "tsx": "^4.21.0",
        "winston": "^3.15.0",
        "xml2js": "^0.6.2"
    },
    "overrides": {
        "form-data": "^4.0.0",
        "qs": "^6.14.3",
        "tough-cookie": "^4.1.3"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.7",
        "@types/express": "^5.0.6",
        "@types/node": "^25.2.3",
        "@vitest/coverage-v8": "^4.0.18",
        "nodemon": "^3.1.7",
        "typescript": "^5.9.3",
        "vitest": "^4.0.18"
    }
